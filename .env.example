# =========================================================================
# CONDACCESS - VARIÁVEIS DE AMBIENTE PARA O BACKEND (FastAPI + Supabase)
# =========================================================================

# 1. Adicione '+psycopg' no início e coloque sua senha real do banco:
DATABASE_URL=postgresql+psycopg://postgres.SUA_REF_AQUI:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# 2. Sua URL do Supabase (sem espaço e sem aspas):
SUPABASE_URL=https://SUA_REF_AQUI.supabase.co

# 3. Cole a Publishable key (sem parênteses ou textos extras no final):
SUPABASE_ANON_KEY=Publishable_key

# 4. Cole a Secret key (sem parênteses ou textos extras no final):
SUPABASE_SERVICE_ROLE_KEY=Secret_key

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000